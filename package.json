{
  "name": "app-song-print",
  "version": "0.1.0",
  "description": "A template for building enterprise-grade web applications using React, TypeScript, and modern tooling.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=21.0.0 <25.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "clean": "pnpm clean:root && turbo run clean",
    "clean:all": "pnpm clean:root && turbo run clean:all",
    "clean:root": "rimraf output",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix && sherif --fix",
    "build": "turbo run build",
    "build:libs": "turbo run build:libs",
    "deploy": "turbo run deploy",
    "deploy:demo": "turbo run deploy:demo",
    "storybook": "turbo run storybook",
    "storybook:build": "turbo run storybook:build",
    "storybook:nopen": "turbo run storybook:nopen",
    "test": "turbo run test",
    "test:ci": "turbo run test:ci",
    "test:coverage": "turbo run test:coverage",
    "test:coverage:ci": "turbo run test:coverage:ci"
  },
  "devDependencies": {
    "@commitlint/cli": "21.1.0",
    "@commitlint/config-conventional": "21.1.0",
    "@commitlint/types": "21.1.0",
    "@types/node": "24.13.2",
    "fast-xml-parser": "5.10.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "move-cli": "catalog:dev",
    "nyc": "catalog:dev",
    "prettier": "3.9.1",
    "prettier-plugin-tailwindcss": "0.8.0",
    "rimraf": "catalog:dev",
    "sherif": "1.12.0",
    "tsup": "8.5.1",
    "turbo": "2.10.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@heroui/shared-utils",
      "sharp"
    ]
  },
  "lint-staged": {
    "*.js": "prettier --write",
    "*.ts": "prettier --write",
    "*.tsx": "prettier --write",
    "*.scss": "prettier --write"
  }
}
